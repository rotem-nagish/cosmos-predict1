# Cosmos Predict1 Environment Configuration
# Copy this file to .env and adjust paths for your system

# CUDA Configuration
# Uncomment and set if you need specific CUDA paths
# CUDA_VERSION=12.8
# NVTE_CUDA_INCLUDE_DIR=/usr/local/cuda-12.8/include
# LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:/usr/lib/aarch64-linux-gnu
# TORCH_CUDA_ARCH_LIST=12.0
# TORCH_NVCC_FLAGS=-arch=sm_120

# Python Environment Path (conda/venv bin directory)
# Leave empty to use system PATH
# PYTHON_ENV_BIN=/home/username/miniforge3/envs/cosmos-predict1/bin

# Distributed Training Configuration (single GPU defaults)
# RANK=0
# LOCAL_RANK=0
# WORLD_SIZE=1
# MASTER_ADDR=127.0.0.1
# MASTER_PORT=29500
# NCCL_SHM_DISABLE=1